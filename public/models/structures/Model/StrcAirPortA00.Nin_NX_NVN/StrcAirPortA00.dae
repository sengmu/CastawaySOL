            <source>surface_mGlass-bump</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_mGlass-specular">
          <surface type="2D">
            <init_from>mGlass_Mix</init_from>
            <format>A8R8G8B8</format>
          </surface>
