            <source>surface_mGlass-specular</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <diffuse>
              <texture texture="sampler_mGlass-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <bump>
              <texture texture="sampler_mGlass-bump" texcoord="CHANNEL0" />
            </bump>
            <specular>
              <texture texture="sampler_mGlass-specular" texcoord="CHANNEL0" />
            </specular>
            <emission>
