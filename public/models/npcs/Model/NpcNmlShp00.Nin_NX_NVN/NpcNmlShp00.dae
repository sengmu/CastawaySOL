  <library_materials>
    <material id="mBody">
      <instance_effect url="#Effect_mBody" />
    </material>
    <material id="mEye">
      <instance_effect url="#Effect_mEye" />
    </material>
    <material id="mMouth">
      <instance_effect url="#Effect_mMouth" />
    </material>
  </library_materials>
  <library_effects>
    <effect id="Effect_mBody">
      <profile_COMMON>
        <newparam sid="surface_mBody-diffuse">
          <surface type="2D">
            <init_from>mBody_Alb</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_mBody-diffuse">
          <sampler2D>
            <source>surface_mBody-diffuse</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_mBody-bump">
          <surface type="2D">
            <init_from>mBody_Nrm</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_mBody-bump">
          <sampler2D>
            <source>surface_mBody-bump</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_mBody-specular">
          <surface type="2D">
            <init_from>mBody_Mix</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_mBody-specular">
          <sampler2D>
            <source>surface_mBody-specular</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <diffuse>
              <texture texture="sampler_mBody-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <bump>
              <texture texture="sampler_mBody-bump" texcoord="CHANNEL0" />
            </bump>
            <specular>
              <texture texture="sampler_mBody-specular" texcoord="CHANNEL0" />
            </specular>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Effect_mEye">
      <profile_COMMON>
        <newparam sid="surface_mEye-diffuse">
          <surface type="2D">
            <init_from>mEye_Alb.0</init_from>
