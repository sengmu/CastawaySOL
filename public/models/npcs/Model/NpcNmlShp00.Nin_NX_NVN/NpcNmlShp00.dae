            <diffuse>
              <texture texture="sampler_mEye-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <bump>
              <texture texture="sampler_mEye-bump" texcoord="CHANNEL0" />
            </bump>
            <specular>
